{
  "tasks": {
    "start": "deno run -A main.ts",
    "debug": "deno run --inspect-brk -A main.ts",
    "format": "deno fmt",
    "lint": "deno lint",
    "test": "ENV_TYPE=test deno test --allow-env"
  },
  "fmt": {
    "exclude": [
      "*.md",
      "docs/",
      "assets/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/testing": "jsr:@std/testing@1.0.21"
  }
}
